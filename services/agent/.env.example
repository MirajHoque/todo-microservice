# Copy to .env and fill in the values: cp .env.example .env
# .env is git-ignored — never commit real secrets.

# Server
HOST=0.0.0.0
PORT=8083
ENV=development

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Database — the agent's own database and user (created by `make db`)
DATABASE_URL=postgresql://agent:agent@localhost:5433/agent_db
DB_MIN_CONNS=1
DB_MAX_CONNS=5

# Auth (required) — MUST be the same value as JWT_SECRET in
# services/api/.env: the api signs tokens with it, this service checks them.
# At least 32 characters, or the service won't start.
JWT_SECRET=change-me

# The api service (owns todos). The agent's tools call it over HTTP
# with the user's own JWT. Native: http://localhost:8080
API_URL=http://localhost:8080
API_TIMEOUT_SECONDS=10

# The LLM (required) — any model via OpenRouter: https://openrouter.ai/keys
# Model ids: https://openrouter.ai/models (models get retired — update when needed)
OPENROUTER_API_KEY=change-me
AGENT_MODEL=anthropic/claude-sonnet-5.5
AGENT_MAX_STEPS=20
# Lower if OpenRouter says "requires more credits" (402)
LLM_MAX_TOKENS=16000

# Guardrails, per user (429 when reached; logging out doesn't reset them)
CHAT_MESSAGES_PER_HOUR=30
DAILY_COST_LIMIT_USD=0.50
