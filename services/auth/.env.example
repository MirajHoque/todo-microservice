# Copy to .env and fill in the values: cp .env.example .env
# .env is git-ignored — never commit real secrets.

# Server
HOST=0.0.0.0
PORT=8081
ENV=development

# Database (required) — this service's own database and user (created by `make db`)
DATABASE_URL=postgres://auth:auth@localhost:5433/auth_db?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Auth (required) — generate with: openssl rand -base64 32
# MUST be the same value in every service: auth signs tokens with it,
# the others (api/todo, agent) check them with it.
JWT_SECRET=change-me
JWT_EXPIRY=24h
BCRYPT_COST=12

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
