# Keep the build context small and secret-free.
# Only Go source, go.mod/go.sum, migrations/ and web/ are needed.

# Git
.git
.gitignore

# Secrets — never send these to the build context
.env
.env.*

# Docker files themselves (changing them shouldn't bust the COPY cache)
Dockerfile
.dockerignore
compose*.yaml
compose*.yml

# Build output
bin/
dist/

# Development tools
Makefile

# Go test files — not needed in production image
*_test.go

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Grafana dashboard (not needed at runtime)
grafana/

# Docs
*.md
