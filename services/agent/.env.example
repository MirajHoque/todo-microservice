# Copy to .env and fill in the values: cp .env.example .env
# .env is git-ignored — never commit real secrets.

# Server
HOST=0.0.0.0
PORT=8083
ENV=development

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Database — the agent's own database and user (created by `make db`)
DATABASE_URL=postgresql://agent:agent@localhost:5433/agent_db
DB_MIN_CONNS=1
DB_MAX_CONNS=5

# Auth (required) — MUST be the same value as JWT_SECRET in
# services/api/.env: the api signs tokens with it, this service checks them.
# At least 32 characters, or the service won't start.
JWT_SECRET=change-me
