# Copy to .env and fill in the values: cp .env.example .env
# .env is git-ignored — never commit real secrets.

# Server
HOST=0.0.0.0
PORT=8080
ENV=development

# Database (required)
DATABASE_URL=postgres://todo:todo@localhost:5433/todo?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Auth (required) — generate with: openssl rand -base64 32
JWT_SECRET=change-me
JWT_EXPIRY=24h
BCRYPT_COST=12

# Agents (required) — https://openrouter.ai/keys
OPENROUTER_API_KEY=change-me
AGENT_MODEL=claude-sonnet-4-20250514

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
