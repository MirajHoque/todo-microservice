# Copy to .env and fill in the values: cp .env.example .env
# .env is git-ignored — never commit real secrets.

# Server
HOST=0.0.0.0
PORT=8082
ENV=development

# Database (required) — this service's own database and user (created by `make db`)
DATABASE_URL=postgres://todo_svc:todo_svc@localhost:5433/todo_db?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Auth (required) — only used to CHECK tokens.
# MUST be the same value as JWT_SECRET in services/auth/.env (auth signs
# the tokens) and services/agent/.env.
JWT_SECRET=change-me

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
