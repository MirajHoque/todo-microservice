# Copy to .env.local and adjust if needed: cp .env.example .env.local
# .env.local is git-ignored — every developer keeps their own.
#
# Where each backend runs. Requests to /api/... are forwarded by
# path (see proxy.ts). Read when the server starts. Server-only:
# never sent to the browser.

# The Go api (auth + todos) — make dev in services/api
API_URL=http://localhost:8080

# The Python agent (/api/v1/agent/...) — make dev in services/agent
AGENT_URL=http://localhost:8083
