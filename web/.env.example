# Copy to .env.local and adjust if needed: cp .env.example .env.local
# .env.local is git-ignored — every developer keeps their own.

# Where the Go API runs. Requests to /api/... are forwarded here
# (see proxy.ts). Read when the server starts. Server-only: never sent to the browser.
#   Native (make dev in services/api): http://localhost:8080
API_URL=http://localhost:8080
